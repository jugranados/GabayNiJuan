# Copy to `.env.local` (git-ignored) and fill in values.
# EXPO_PUBLIC_* values are bundled into the app and are visible to anyone who
# downloads it. Only put PUBLIC values here.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY (or any sb_secret_ key) in this app.

# Which repository implementation the app uses: "mock" (fictional fixtures) or "supabase".
EXPO_PUBLIC_DATA_SOURCE=mock

# Required only when EXPO_PUBLIC_DATA_SOURCE=supabase.
# Use the project's anon / publishable key. Row Level Security must restrict it to published data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
