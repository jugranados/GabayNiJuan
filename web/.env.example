# Copy to .env.local (git-ignored). See docs/WEB_MIGRATION.md.

# mock     = fictional in-memory fixtures (default; needs nothing else)
# supabase = the project below, read with the public anon key through Row Level Security
DATA_SOURCE=mock

# PUBLIC values: they are sent to every browser. Use the anon / publishable key ONLY.
# Never put a service-role or sb_secret_ key here; the app refuses to start if it sees one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin of the deployed site, used for canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search-engine indexing. Leave "false" while the database holds fictional development data.
# Only takes effect with DATA_SOURCE=supabase.
SITE_INDEXABLE=false
